{
  "name": "hermes-ide",
  "displayName": "Hermes IDE",
  "description": "%ext.description%",
  "version": "0.2.0",
  "publisher": "yahya",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%ext.untrusted%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes",
          "title": "Hermes Agent",
          "icon": "media/hermes.svg"
        }
      ]
    },
    "views": {
      "hermes": [
        {
          "type": "webview",
          "id": "hermes.chat",
          "name": "%view.chat%"
        }
      ],
      "explorer": [
        {
          "id": "hermes.sessions",
          "name": "%view.sessions%"
        }
      ]
    },
    "commands": [
      {
        "command": "hermes.openChat",
        "title": "%cmd.openChat%",
        "category": "Hermes"
      },
      {
        "command": "hermes.newSession",
        "title": "%cmd.newSession%",
        "category": "Hermes",
        "icon": "$(add)"
      },
      {
        "command": "hermes.stop",
        "title": "%cmd.stop%",
        "category": "Hermes",
        "icon": "$(debug-stop)"
      },
      {
        "command": "hermes.restart",
        "title": "%cmd.restart%",
        "category": "Hermes"
      },
      {
        "command": "hermes.configureEndpoint",
        "title": "%cmd.configureEndpoint%",
        "category": "Hermes",
        "icon": "$(settings-gear)"
      },
      {
        "command": "hermes.showLog",
        "title": "%cmd.showLog%",
        "category": "Hermes"
      },
      {
        "command": "hermes.exportLogs",
        "title": "%cmd.exportLogs%",
        "category": "Hermes"
      },
      {
        "command": "hermes.clearAllowlist",
        "title": "%cmd.clearAllowlist%",
        "category": "Hermes"
      },
      {
        "command": "hermes.diff.accept",
        "title": "%cmd.diffAccept%",
        "category": "Hermes",
        "icon": "$(check)"
      },
      {
        "command": "hermes.diff.reject",
        "title": "%cmd.diffReject%",
        "category": "Hermes",
        "icon": "$(close)"
      },
      {
        "command": "hermes.diff.toggleHunk",
        "title": "%cmd.toggleHunk%",
        "category": "Hermes"
      },
      {
        "command": "hermes.inlineEdit",
        "title": "%cmd.inlineEdit%",
        "category": "Hermes",
        "icon": "$(sparkle)"
      },
      {
        "command": "hermes.addSelectionToChat",
        "title": "%cmd.addSelectionToChat%",
        "category": "Hermes"
      },
      {
        "command": "hermes.addToChat",
        "title": "%cmd.addToChat%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.refresh",
        "title": "%cmd.sessionsRefresh%",
        "category": "Hermes",
        "icon": "$(refresh)"
      },
      {
        "command": "hermes.sessions.open",
        "title": "%cmd.sessionsOpen%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.delete",
        "title": "%cmd.sessionsDelete%",
        "category": "Hermes",
        "icon": "$(trash)"
      },
      {
        "command": "hermes.switchProfile",
        "title": "%cmd.switchProfile%",
        "category": "Hermes"
      },
      {
        "command": "hermes.removeApprovalHook",
        "title": "%cmd.removeApprovalHook%",
        "category": "Hermes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hermes.newSession",
          "when": "view == hermes.chat",
          "group": "navigation@1"
        },
        {
          "command": "hermes.configureEndpoint",
          "when": "view == hermes.chat",
          "group": "navigation@2"
        },
        {
          "command": "hermes.newSession",
          "when": "view == hermes.sessions",
          "group": "navigation@1"
        },
        {
          "command": "hermes.sessions.refresh",
          "when": "view == hermes.sessions",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "hermes.diff.accept",
          "when": "hermes.diffReviewActive && resourceScheme == hermes-diff",
          "group": "navigation@1"
        },
        {
          "command": "hermes.diff.reject",
          "when": "hermes.diffReviewActive && resourceScheme == hermes-diff",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "hermes.diff.accept",
          "when": "hermes.diffReviewActive"
        },
        {
          "command": "hermes.diff.reject",
          "when": "hermes.diffReviewActive"
        },
        {
          "command": "hermes.diff.toggleHunk",
          "when": "false"
        },
        {
          "command": "hermes.sessions.open",
          "when": "false"
        },
        {
          "command": "hermes.sessions.delete",
          "when": "false"
        },
        {
          "command": "hermes.addToChat",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "hermes.sessions.delete",
          "when": "view == hermes.sessions && viewItem =~ /^hermesSession/",
          "group": "inline"
        },
        {
          "command": "hermes.sessions.delete",
          "when": "view == hermes.sessions && viewItem =~ /^hermesSession/",
          "group": "9_delete"
        }
      ],
      "editor/context": [
        {
          "command": "hermes.inlineEdit",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "hermes@1"
        },
        {
          "command": "hermes.addSelectionToChat",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "hermes@2"
        }
      ],
      "explorer/context": [
        {
          "command": "hermes.addToChat",
          "group": "hermes@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hermes.diff.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "hermes.diffReviewActive && editorFocus && resourceScheme == hermes-diff"
      },
      {
        "command": "hermes.diff.reject",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "hermes.diffReviewActive && editorFocus && resourceScheme == hermes-diff"
      },
      {
        "command": "hermes.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && editorHasSelection && !editorReadonly && config.hermes.inlineEdit.useCtrlK && resourceScheme == file"
      },
      {
        "command": "hermes.addSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "configuration": {
      "title": "Hermes IDE",
      "properties": {
        "hermes.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.path%"
        },
        "hermes.language": {
          "type": "string",
          "enum": [
            "auto",
            "id",
            "en"
          ],
          "default": "auto",
          "markdownDescription": "%cfg.language%"
        },
        "hermes.activeProfile": {
          "type": "string",
          "default": "hermes",
          "markdownDescription": "%cfg.activeProfile%"
        },
        "hermes.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "%cfg.profiles%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl",
              "model"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "contextLength": {
                "type": "number"
              }
            }
          }
        },
        "hermes.mcpServers": {
          "type": "array",
          "default": [],
          "markdownDescription": "%cfg.mcpServers%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "hermes.terminal.askEveryCommand": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.askEveryCommand%"
        },
        "hermes.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.nodePath%"
        },
        "hermes.inlineEdit.useCtrlK": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.useCtrlK%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "package": "node esbuild.mjs --production && npx --yes @vscode/vsce@latest package --no-dependencies --allow-missing-repository --skip-license --no-rewrite-relative-links",
    "test:vscode": "node esbuild.mjs && node test/vscode/runTest.mjs"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "dompurify": "^3.2.3",
    "esbuild": "^0.28.2",
    "marked": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
