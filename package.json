{
  "name": "hermes-ide",
  "displayName": "Hermes IDE",
  "description": "%ext.description%",
  "version": "0.6.0",
  "publisher": "yahya",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:hermes.chatPanel"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%ext.untrusted%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes-ide",
          "title": "Hermes IDE",
          "icon": "media/hermes.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "hermes-ide-secondary",
          "title": "Hermes",
          "icon": "media/hermes.svg",
          "when": "!hermes.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "hermes-ide": [
        {
          "type": "webview",
          "id": "hermes.chat",
          "name": "%view.chat%"
        }
      ],
      "hermes-ide-secondary": [
        {
          "type": "webview",
          "id": "hermes.chatSecondary",
          "name": "%view.chat%",
          "when": "!hermes.doesNotSupportSecondarySidebar"
        }
      ],
      "explorer": [
        {
          "id": "hermes.sessions",
          "name": "%view.sessions%"
        }
      ]
    },
    "commands": [
      {
        "command": "hermes.openChat",
        "title": "%cmd.openChat%",
        "category": "Hermes"
      },
      {
        "command": "hermes.openInEditor",
        "title": "%cmd.openInEditor%",
        "category": "Hermes",
        "icon": {
          "light": "media/hermes-light.svg",
          "dark": "media/hermes-dark.svg"
        }
      },
      {
        "command": "hermes.newSession",
        "title": "%cmd.newSession%",
        "category": "Hermes",
        "icon": "$(add)"
      },
      {
        "command": "hermes.stop",
        "title": "%cmd.stop%",
        "category": "Hermes",
        "icon": "$(debug-stop)"
      },
      {
        "command": "hermes.restart",
        "title": "%cmd.restart%",
        "category": "Hermes"
      },
      {
        "command": "hermes.configureEndpoint",
        "title": "%cmd.configureEndpoint%",
        "category": "Hermes",
        "icon": "$(settings-gear)"
      },
      {
        "command": "hermes.showLog",
        "title": "%cmd.showLog%",
        "category": "Hermes"
      },
      {
        "command": "hermes.exportLogs",
        "title": "%cmd.exportLogs%",
        "category": "Hermes"
      },
      {
        "command": "hermes.clearAllowlist",
        "title": "%cmd.clearAllowlist%",
        "category": "Hermes"
      },
      {
        "command": "hermes.diff.accept",
        "title": "%cmd.diffAccept%",
        "category": "Hermes",
        "icon": "$(check)"
      },
      {
        "command": "hermes.diff.reject",
        "title": "%cmd.diffReject%",
        "category": "Hermes",
        "icon": "$(close)"
      },
      {
        "command": "hermes.diff.toggleHunk",
        "title": "%cmd.toggleHunk%",
        "category": "Hermes"
      },
      {
        "command": "hermes.inlineEdit",
        "title": "%cmd.inlineEdit%",
        "category": "Hermes",
        "icon": "$(sparkle)"
      },
      {
        "command": "hermes.addSelectionToChat",
        "title": "%cmd.addSelectionToChat%",
        "category": "Hermes"
      },
      {
        "command": "hermes.addToChat",
        "title": "%cmd.addToChat%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.refresh",
        "title": "%cmd.sessionsRefresh%",
        "category": "Hermes",
        "icon": "$(refresh)"
      },
      {
        "command": "hermes.sessions.open",
        "title": "%cmd.sessionsOpen%",
        "category": "Hermes"
      },
      {
        "command": "hermes.sessions.delete",
        "title": "%cmd.sessionsDelete%",
        "category": "Hermes",
        "icon": "$(trash)"
      },
      {
        "command": "hermes.switchProfile",
        "title": "%cmd.switchProfile%",
        "category": "Hermes"
      },
      {
        "command": "hermes.removeApprovalHook",
        "title": "%cmd.removeApprovalHook%",
        "category": "Hermes"
      },
      {
        "command": "hermes.completion.toggle",
        "title": "%cmd.completionToggle%",
        "category": "Hermes"
      },
      {
        "command": "hermes.index.rebuild",
        "title": "%cmd.indexRebuild%",
        "category": "Hermes"
      },
      {
        "command": "hermes.index.search",
        "title": "%cmd.indexSearch%",
        "category": "Hermes",
        "icon": "$(search)"
      },
      {
        "command": "hermes.update.check",
        "title": "%cmd.updateCheck%",
        "category": "Hermes"
      },
      {
        "command": "hermes.rules.open",
        "title": "%cmd.rulesOpen%",
        "category": "Hermes"
      },
      {
        "command": "hermes.usage.show",
        "title": "%cmd.usageShow%",
        "category": "Hermes"
      },
      {
        "command": "hermes.checkpoint.undoRestore",
        "title": "%cmd.checkpointUndo%",
        "category": "Hermes"
      },
      {
        "command": "hermes.hermesInstall",
        "title": "%cmd.hermesInstall%",
        "category": "Hermes"
      },
      {
        "command": "hermes.hermesSetup",
        "title": "%cmd.hermesSetup%",
        "category": "Hermes"
      },
      {
        "command": "hermes.hermesCheckUpdate",
        "title": "%cmd.hermesCheckUpdate%",
        "category": "Hermes"
      },
      {
        "command": "hermes.hermesUpdate",
        "title": "%cmd.hermesUpdate%",
        "category": "Hermes"
      },
      {
        "command": "hermes.learning.toggle",
        "title": "%cmd.learningToggle%",
        "category": "Hermes"
      },
      {
        "command": "hermes.deploy.history",
        "title": "%cmd.deployHistory%",
        "category": "Hermes"
      },
      {
        "command": "hermes.stack.add",
        "title": "%cmd.stackAdd%",
        "category": "Hermes"
      },
      {
        "command": "hermes.privacy.toggle",
        "title": "%cmd.privacyToggle%",
        "category": "Hermes"
      },
      {
        "command": "hermes.privacy.report",
        "title": "%cmd.privacyReport%",
        "category": "Hermes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hermes.newSession",
          "when": "view == hermes.sessions",
          "group": "navigation@1"
        },
        {
          "command": "hermes.sessions.refresh",
          "when": "view == hermes.sessions",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "hermes.openInEditor",
          "group": "navigation@3"
        },
        {
          "command": "hermes.diff.accept",
          "when": "hermes.diffReviewActive && resourceScheme == hermes-diff",
          "group": "navigation@1"
        },
        {
          "command": "hermes.diff.reject",
          "when": "hermes.diffReviewActive && resourceScheme == hermes-diff",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "hermes.diff.accept",
          "when": "hermes.diffReviewActive"
        },
        {
          "command": "hermes.diff.reject",
          "when": "hermes.diffReviewActive"
        },
        {
          "command": "hermes.diff.toggleHunk",
          "when": "false"
        },
        {
          "command": "hermes.sessions.open",
          "when": "false"
        },
        {
          "command": "hermes.sessions.delete",
          "when": "false"
        },
        {
          "command": "hermes.addToChat",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "hermes.sessions.delete",
          "when": "view == hermes.sessions && viewItem =~ /^hermesSession/",
          "group": "inline"
        },
        {
          "command": "hermes.sessions.delete",
          "when": "view == hermes.sessions && viewItem =~ /^hermesSession/",
          "group": "9_delete"
        }
      ],
      "editor/context": [
        {
          "command": "hermes.inlineEdit",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "hermes@1"
        },
        {
          "command": "hermes.addSelectionToChat",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "hermes@2"
        }
      ],
      "explorer/context": [
        {
          "command": "hermes.addToChat",
          "group": "hermes@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hermes.diff.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "hermes.diffReviewActive && editorFocus && resourceScheme == hermes-diff"
      },
      {
        "command": "hermes.diff.reject",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "hermes.diffReviewActive && editorFocus && resourceScheme == hermes-diff"
      },
      {
        "command": "hermes.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && editorHasSelection && !editorReadonly && config.hermes.inlineEdit.useCtrlK && resourceScheme == file"
      },
      {
        "command": "hermes.addSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "configuration": {
      "title": "Hermes IDE",
      "properties": {
        "hermes.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.path%"
        },
        "hermes.language": {
          "type": "string",
          "enum": [
            "auto",
            "id",
            "en"
          ],
          "default": "id",
          "markdownDescription": "%cfg.language%"
        },
        "hermes.agentLanguage": {
          "type": "string",
          "enum": [
            "ui",
            "id",
            "en",
            "off"
          ],
          "default": "ui",
          "markdownDescription": "%cfg.agentLanguage%"
        },
        "hermes.narrateSteps": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.narrateSteps%"
        },
        "hermes.learning.level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate"
          ],
          "default": "beginner",
          "markdownDescription": "%cfg.learningLevel%"
        },
        "hermes.activeProfile": {
          "type": "string",
          "default": "hermes",
          "markdownDescription": "%cfg.activeProfile%"
        },
        "hermes.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "%cfg.profiles%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl",
              "model"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "contextLength": {
                "type": "number"
              }
            }
          }
        },
        "hermes.mcpServers": {
          "type": "array",
          "default": [],
          "markdownDescription": "%cfg.mcpServers%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "hermes.terminal.askEveryCommand": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.askEveryCommand%"
        },
        "hermes.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.nodePath%"
        },
        "hermes.inlineEdit.useCtrlK": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.useCtrlK%"
        },
        "hermes.completion.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.completionEnabled%"
        },
        "hermes.completion.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.completionBaseUrl%"
        },
        "hermes.completion.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.completionModel%"
        },
        "hermes.completion.template": {
          "type": "string",
          "enum": [
            "auto",
            "suffix",
            "qwen",
            "starcoder",
            "codellama",
            "deepseek"
          ],
          "default": "auto",
          "markdownDescription": "%cfg.completionTemplate%"
        },
        "hermes.completion.maxTokens": {
          "type": "number",
          "default": 96,
          "minimum": 8,
          "maximum": 512,
          "markdownDescription": "%cfg.completionMaxTokens%"
        },
        "hermes.completion.debounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 2000,
          "markdownDescription": "%cfg.completionDebounce%"
        },
        "hermes.index.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.indexEnabled%"
        },
        "hermes.index.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.indexBaseUrl%"
        },
        "hermes.index.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.indexModel%"
        },
        "hermes.index.maxFileKB": {
          "type": "number",
          "default": 256,
          "minimum": 8,
          "maximum": 4096,
          "markdownDescription": "%cfg.indexMaxFileKB%"
        },
        "hermes.update.check": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "%cfg.updateCheck%"
        },
        "hermes.update.feedUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%cfg.updateFeedUrl%"
        },
        "hermes.pricing": {
          "type": "object",
          "default": {},
          "markdownDescription": "%cfg.pricing%",
          "additionalProperties": {
            "type": "object",
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0,
                "description": "Price per 1M input tokens."
              },
              "output": {
                "type": "number",
                "minimum": 0,
                "description": "Price per 1M output tokens."
              },
              "cachedInput": {
                "type": "number",
                "minimum": 0,
                "description": "Price per 1M cached input tokens (defaults to input)."
              }
            }
          }
        },
        "hermes.usage.currency": {
          "type": "string",
          "default": "$",
          "markdownDescription": "%cfg.usageCurrency%"
        },
        "hermes.notifications.mode": {
          "type": "string",
          "enum": [
            "off",
            "unfocused",
            "always"
          ],
          "default": "unfocused",
          "markdownDescription": "%cfg.notifyMode%"
        },
        "hermes.notifications.minSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 600,
          "markdownDescription": "%cfg.notifyMinSeconds%"
        },
        "hermes.notifications.native": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.notifyNative%"
        },
        "hermes.hermesUpdate.check": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.hermesUpdateCheck%"
        },
        "hermes.privacy.localOnly": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%cfg.privacyLocalOnly%"
        },
        "hermes.privacy.allowedHosts": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%cfg.privacyAllowedHosts%"
        },
        "hermes.routing.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%cfg.routingEnabled%"
        },
        "hermes.routing.lightModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%cfg.routingLight%"
        },
        "hermes.routing.heavyModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%cfg.routingHeavy%"
        },
        "hermes.routing.fallbackModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%cfg.routingFallback%"
        },
        "hermes.routing.lightMaxChars": {
          "type": "integer",
          "default": 280,
          "minimum": 20,
          "maximum": 4000,
          "scope": "application",
          "markdownDescription": "%cfg.routingMaxChars%"
        },
        "hermes.deploy.targets": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "object",
            "required": [
              "name",
              "host",
              "user"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "identityFile": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "gitRemote": {
                "type": "string"
              },
              "steps": {
                "type": "string"
              }
            }
          },
          "markdownDescription": "%cfg.deployTargets%"
        },
        "hermes.tasks.maxParallel": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "scope": "application",
          "markdownDescription": "%cfg.tasksMaxParallel%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "package": "node esbuild.mjs --production && npx --yes @vscode/vsce@latest package --no-dependencies --allow-missing-repository --skip-license --no-rewrite-relative-links",
    "test:vscode": "node esbuild.mjs && node test/vscode/runTest.mjs",
    "ide:stage": "node ide/scripts/build.mjs --stage-only",
    "ide:build": "node ide/scripts/build.mjs",
    "ide:release": "node ide/scripts/build.mjs --release",
    "ide:smoke": "node ide/scripts/smoke.mjs",
    "publish:openvsx": "node ide/scripts/publish-openvsx.mjs"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "dompurify": "^3.2.3",
    "esbuild": "^0.28.2",
    "innosetup-compiler": "^6.3.1",
    "marked": "^15.0.4",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
